diff --git a/export_teacher.py b/export_teacher.py
new file mode 100644
index 0000000..e030acf
--- /dev/null
+++ b/export_teacher.py
@@ -0,0 +1,11 @@
+"""Export the frozen teacher (705613 best_reward) and its normalizers to npz for a numpy re-implementation."""
+import sys, numpy as np, torch
+ck = torch.load(sys.argv[1], map_location='cpu')
+out = {}
+for k, v in ck['model'].items():
+    out['model.' + k] = v.float().numpy()
+for name in ('running_mean_std', 'priv_mean_std', 'point_cloud_mean_std'):
+    for k, v in ck[name].items():
+        out[f'{name}.{k}'] = v.double().numpy()
+np.savez(sys.argv[2], **out)
+print('EXPORTED', len(out), sorted(k for k in out if k.startswith('model.'))[:40])
